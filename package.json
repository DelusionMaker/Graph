{
  "name": "react-litegraph-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:canvas": "node scripts/verify-canvas.mjs",
    "verify:acceptance": "node scripts/verify-acceptance.mjs",
    "verify:3d": "node scripts/verify-3d.mjs",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,html}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@comfyorg/litegraph": "0.17.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "^6.39.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
